digraph S {
  rankdir=TB; nodesep=0.25; ranksep=0.55;
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=15, fillcolor="#E8F5E9", color="#2E7D32"];
  edge [fontname="Arial", fontsize=12, color="#555555"];
  INCOMING [fillcolor="#F4F6F8", color="#777777"];
  IN_TRANSIT [fillcolor="#F4F6F8", color="#777777"];
  SHIPPED [fillcolor="#F4F6F8", color="#777777"];
  RETURN_PENDING [fillcolor="#F4F6F8", color="#777777"];
  TO_VERIFY [fillcolor="#FFF4E5", color="#E29100"];
  LOST [fillcolor="#FFEBEE", color="#C62828"];
  SCRAPPED [fillcolor="#FFEBEE", color="#C62828", peripheries=2];
  INCOMING -> AVAILABLE [label="réception"];
  AVAILABLE -> ALLOCATED [label="attribution"];
  ALLOCATED -> AVAILABLE [label="désattribution"];
  ALLOCATED -> SHIPPED [label="expédition"];
  SHIPPED -> ALLOCATED [label="expédition\nannulée", style=dashed];
  AVAILABLE -> SHIPPED [label="a posteriori"];
  ALLOCATED -> TO_VERIFY [label="annulation\nsans remise"];
  AVAILABLE -> HELD [label="réservation"];
  HELD -> AVAILABLE [label="fin"];
  HELD -> ALLOCATED [label="attribution"];
  AVAILABLE -> QUALITY_CONTROL [label="contrôle"];
  QUALITY_CONTROL -> AVAILABLE [label="conforme"];
  DAMAGED -> AVAILABLE [label="réparée", style=dashed];
  QUALITY_CONTROL -> DAMAGED [label="non conforme"];
  AVAILABLE -> DAMAGED [label="dommage"];
  DAMAGED -> SCRAPPED [label="rebut"];
  AVAILABLE -> LOST; DAMAGED -> LOST; IN_TRANSIT -> LOST; HELD -> LOST; QUALITY_CONTROL -> LOST;
  INCOMING -> SCRAPPED [label="annulée"];
  AVAILABLE -> IN_TRANSIT [label="départ"];
  IN_TRANSIT -> AVAILABLE [label="arrivée ou\nannulation (origine)"];
  SHIPPED -> RETURN_PENDING [label="retour approuvé"];
  RETURN_PENDING -> SHIPPED [label="refusé / annulé"];
  RETURN_PENDING -> AVAILABLE [label="remis en stock"];
  SHIPPED -> AVAILABLE [label="remboursement\navec remise"];
  RETURN_PENDING -> QUALITY_CONTROL [label="contrôle requis"];
  RETURN_PENDING -> DAMAGED; RETURN_PENDING -> SCRAPPED; RETURN_PENDING -> LOST [label="manquant"];
  TO_VERIFY -> AVAILABLE [label="retrouvée"]; TO_VERIFY -> SCRAPPED; TO_VERIFY -> LOST;
  LOST -> AVAILABLE [label="retrouvée"];
}
